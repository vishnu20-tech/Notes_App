<% layout('./layouts/boilerplate') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <!-- Back Button -->
            <a href="/notes" class="btn btn-outline-secondary btn-sm mb-4">
                <i class="bi bi-arrow-left me-1"></i> Back to My Notes
            </a>

            <!-- Note Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <span class="badge bg-primary-subtle text-primary mb-3">
                                <i class="bi bi-journal-text me-1"></i> My Note
                            </span>

                            <h2 class="fw-bold mb-2"><%= note.title %></h2>

                            <p class="text-muted mb-0">
                                <i class="bi bi-person-circle me-1"></i>
                                Created by <%= note.user ? note.user.username : 'Unknown user' %>
                            </p>
                        </div>
                    </div>

                    <hr>

                    <!-- Description -->
                    <h6 class="text-uppercase text-muted fw-semibold mb-3">
                        Note Description
                    </h6>

                    <p class="fs-5 mb-4" style="white-space: pre-wrap;"><%= note.description %></p>

                    <hr>

                    <!-- Dates -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-calendar-plus me-1"></i> Created At
                                </small>
                                <span class="fw-medium">
                                    <%= note.createdAt ? new Date(note.createdAt).toLocaleString('en-IN') : 'N/A' %>
                                </span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-clock-history me-1"></i> Last Updated
                                </small>
                                <span class="fw-medium">
                                    <%= note.updatedAt ? new Date(note.updatedAt).toLocaleString('en-IN') : 'N/A' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Owner Actions -->
                    <% if (currentUser && note.user && note.user._id.toString() === currentUser._id.toString()) { %>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="/notes/<%= note._id %>/edit" class="btn btn-primary">
                                <i class="bi bi-pencil-square me-1"></i> Edit Note
                            </a>

                            <form action="/notes/<%= note._id %>?_method=DELETE"
                                  method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this note?');">

                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete Note
                                </button>
                            </form>
                        </div>

                    <% } %>

                </div>
            </div>

        </div>
    </div>
</div>